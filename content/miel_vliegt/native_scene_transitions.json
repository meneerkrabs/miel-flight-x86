  "predicates": {
    "login_submit": "editing(+0xd4) && lookup_or_create(name) >= 0; blank(-1) and full(-2) remain in login",
    "airplane_complete": "barn.airplane(+0x160).completion(+0x128) == 0x1ff",
    "landing_volume": "marker.enabled(+0x10) && x/z within center +/- 25.0 && center.y <= y < center.y + 50.0",
    "departure_offscreen": "location.state(+0x8dc) in {0,2,3,4,5} && projected aircraft outside viewport",
    "flight_crash_return": "crash(+0x48fd) && fade_armed(+0x48fe) && timer(+0x4900) >= 6.0 && !pending_target(+0x47e4)",
    "mygghanget_state6": "state callback argument == 6",
    "mygghanget_offscreen_return": "state(+0x8dc) == 5 && !flight_departure(+0x4890) && projected aircraft outside viewport",
    "mission_outro": "mecchifinal reward action == PLAY_OUTRO",
    "outro_completion": "event kind == 0 && callback channel/index == 3",
    "exhibition_barn_callback": "event kind == 0 && callback channel/index == 2",
    "exhibition_barn_state": "state callback argument == 5 && outro_return(+0x48ad)",
    "credits_complete": "credits roll/fade complete; queue NULL and begin application shutdown",
    "generic_location_barn": "return(+0x487c) && two_phase_fade(+0x487d/+0x487e) && timer >= 6.0 && fade == 1.0"
  },
